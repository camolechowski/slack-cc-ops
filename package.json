{
  "name": "slops",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/camolechowski/slack-cc-ops"
  },
  "type": "module",
  "bin": "./server.ts",
  "scripts": {
    "start": "bun install --no-summary && bun server.ts",
    "test": "bun test && bash hooks/pretooluse-bash.test.sh && bash scripts/authority-contract.test.sh",
    "check:shell": "bash -n hooks/*.sh scripts/*.sh",
    "check": "bun run test && bun run check:shell"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@slack/bolt": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10"
  }
}
