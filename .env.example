# Slack app credentials (Socket Mode).
# Fill in from api.slack.com/apps → OAuth & Permissions (bot token) and
# Basic Information → App-Level Tokens (app token with connections:write scope).
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Docker socket group ID — bootstrap-mini.sh detects this automatically.
# Override here only if needed (Mac mini default: 1).
HOST_DOCKER_GID=1

# Win deploy controller token (matches ~/.win-deploy-controller/.env).
WIN_DEPLOY_CONTROLLER_TOKEN=

# Win deploy runtime token (matches ~/dvl/win-live/.env).
WIN_DEPLOY_RUNTIME_TOKEN=

# Win API base URL the bot's `win` CLI calls. For the live mini, this is the
# beta runtime (bigwinbeta.olelabs.xyz). Bot's auth.json (mounted at
# ./win-home/auth.json -> /home/botuser/.win/auth.json) must be issued for
# this URL's host.
WIN_API_URL=https://bigwinbeta.olelabs.xyz
