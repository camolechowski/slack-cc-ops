# Slack app credentials (Socket Mode).
# Fill in from api.slack.com/apps → OAuth & Permissions (bot token) and
# Basic Information → App-Level Tokens (app token with connections:write scope).
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Docker socket group ID — bootstrap-mini.sh detects this automatically.
# Override here only if needed (Mac mini default: 1).
HOST_DOCKER_GID=1
